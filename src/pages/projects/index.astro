---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, getPosts, STATUS_ORDER, STATUS_LABEL } from '../../lib/content';

const projects = await getProjects();
const posts = await getPosts();

const postCount = (slug: string) =>
  posts.filter((p) => p.data.project === slug).length;

// Group by status. A status with no projects is simply skipped, so adding
// the first `shipped` project needs no code change.
const groups = STATUS_ORDER.map((status) => ({
  status,
  items: projects
    .filter((p) => p.data.status === status)
    .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()),
})).filter((g) => g.items.length > 0);
---
<BaseLayout
  title="Projects"
  description="Projects documented here, in progress and finished."
>
  <h1>Projects</h1>
  <p class="lede">Everything being built in the open here, newest first.</p>

  {groups.length === 0 && <p>No projects yet.</p>}

  {groups.map((group) => (
    <section class="project-group">
      <h2>{STATUS_LABEL[group.status]}</h2>
      <ul class="project-list">
        {group.items.map((project) => (
          <li>
            <h3><a href={`/projects/${project.id}/`}>{project.data.name}</a></h3>
            <p>{project.data.blurb}</p>
            <p class="meta">
              {postCount(project.id)} {postCount(project.id) === 1 ? 'post' : 'posts'}
              {project.data.url && <> · <a href={project.data.url}>Visit</a></>}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
