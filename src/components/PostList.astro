---
import { formatDate, isoDate, type Post } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  posts: Post[];
  /** Hide the project label on a project's own page, where it's redundant. */
  showProject?: boolean;
  projectNames?: Record<string, string>;
}

const { posts, showProject = false, projectNames = {} } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => (
    <li>
      <h2><a href={url(`/posts/${post.id}/`)}>{post.data.title}</a></h2>
      <p class="meta">
        {/* An undated post has no date to lead with, so the Draft badge
            takes that slot. Separators follow the first item, never open. */}
        {post.data.date
          ? <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          : <strong>Draft</strong>}
        {showProject && post.data.project && (
          <>
            {' · '}
            <a href={url(`/projects/${post.data.project}/`)}>
              {projectNames[post.data.project] ?? post.data.project}
            </a>
          </>
        )}
        {post.data.date && post.data.draft && <> · <strong>Draft</strong></>}
      </p>
      <p>{post.data.summary}</p>
    </li>
  ))}
</ul>
